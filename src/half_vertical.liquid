<div class="layout">
  <div class="columns layout--center gap--medium">
    <div class="column w--auto">
      {% render "fact_icon", category: category, size: 44 %}
    </div>
    <div class="column">
      <div class="markdown">
        <span class="title">{{ text }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Fun Facts</span>
  <span class="instance">Did you know?</span>
</div>
