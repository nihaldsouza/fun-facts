{% template fact_icon %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
{% case category %}
{% when "animal" %}
  <circle cx="12" cy="15.5" r="3.6"/>
  <circle cx="5.3" cy="9.5" r="1.7"/>
  <circle cx="9.7" cy="5" r="1.7"/>
  <circle cx="14.3" cy="5" r="1.7"/>
  <circle cx="18.7" cy="9.5" r="1.7"/>
{% when "ocean" %}
  <path d="M2 9c2-2.5 4-2.5 6 0s4 2.5 6 0 4-2.5 6 0 4 2.5 6 0"/>
  <path d="M2 15c2-2.5 4-2.5 6 0s4 2.5 6 0 4-2.5 6 0 4 2.5 6 0"/>
{% when "space" %}
  <path d="M13.5 4a7.5 7.5 0 1 0 4.9 13.2A8.5 8.5 0 0 1 13.5 4z"/>
  <path d="M19 3v3"/>
  <path d="M17.5 4.5h3"/>
{% when "food" %}
  <path d="M12 8c-3 0-5 2.3-5 5.3 0 3 2 6.7 5 6.7s5-3.7 5-6.7C17 10.3 15 8 12 8z"/>
  <path d="M12 8c0-1.5 0.8-2.5 2-3"/>
  <path d="M12 6.5c1.2-1 2.2-0.6 2.6 0.2"/>
{% when "body" %}
  <path d="M12 20s-7-4.5-9.3-9C1.2 8 2 4.5 5 3.6 7 3 9.5 4 12 7c2.5-3 5-4 7-3.4 3 0.9 3.8 4.4 2.3 7.4C19 15.5 12 20 12 20z"/>
{% when "history" %}
  <path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z"/>
{% when "science" %}
  <circle cx="12" cy="12" r="1.4" fill="currentColor"/>
  <ellipse cx="12" cy="12" rx="9" ry="3.5"/>
  <ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(60 12 12)"/>
  <ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(120 12 12)"/>
{% when "nature" %}
  <path d="M4 20c0-9 6-15 15-15 0 9-6 15-15 15z"/>
  <path d="M4 20c4-4 8-8 15-15"/>
{% else %}
  <path d="M9 18h6"/>
  <path d="M10 22h4"/>
  <path d="M12 2a6 6 0 0 0-6 6c0 2.5 1.5 3.8 2.5 5 .7.8 1 1.5 1.2 2h4.6c.2-.5.5-1.2 1.2-2 1-1.2 2.5-2.5 2.5-5a6 6 0 0 0-6-6z"/>
{% endcase %}
</svg>
{% endtemplate %}
